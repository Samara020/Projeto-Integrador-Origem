DATABASE_URL="postgresql://origem_user:postgres@localhost:5433/origem_db?schema=public"
# No deploy serverless, use o pooler transaction (6543) em DATABASE_URL e o
# pooler session (5432) em DIRECT_URL para migrations.
DIRECT_URL="postgresql://origem_user:postgres@localhost:5433/origem_db?schema=public"
JWT_SECRET="mude_esta_chave_em_producao"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL_TEST="postgresql://USUARIO:SENHA@localhost:5433/origem_teste"
AUTO_SETUP_DB=false
RECOMENDACAO_API_URL="http://localhost:3001"
RECOMENDACAO_API_KEY="origem-mockup-key"
RECOMENDACAO_TIMEOUT_MS=2000
